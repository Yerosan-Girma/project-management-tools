# Application Configuration
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Database Configuration (PostgreSQL / Neon with Prisma)
# For Neon / pooled databases, use pooled endpoint for DATABASE_URL and direct endpoint for DIRECT_URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/teamflow_db?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/teamflow_db?schema=public

# Authentication Secrets
JWT_ACCESS_SECRET=super_secret_jwt_access_token_key_change_in_production_min32chars
JWT_REFRESH_SECRET=super_secret_jwt_refresh_token_key_change_in_production_min32chars
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Redis Configuration (Optional, fallback to in-memory)
REDIS_URL=redis://localhost:6379

# Email Configuration
# Choose exactly one provider: smtp, mailtrap, resend, or console (development only).
# For production on Render/cloud platforms, use 'mailtrap' or 'resend'
EMAIL_PROVIDER=mailtrap
EMAIL_FROM="TeamFlow <noreply@your-verified-domain.com>"

# Mailtrap API
# Get your token from: https://mailtrap.com/
MAILTRAP_TOKEN=

# Resend API key (SMTP transport)
RESEND_API_KEY=

# SMTP provider credentials (use a provider available from your hosting platform)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Storage Configuration (S3 / MinIO compatible)
STORAGE_ENDPOINT=
STORAGE_BUCKET=teamflow-attachments
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Google OAuth Configuration (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Logging
LOG_LEVEL=info
